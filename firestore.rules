rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function member(fid) { return signed() && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.memberIds; }
  function owner(fid) { return signed() && get(/databases/$(database)/documents/families/$(fid)).data.ownerId == request.auth.uid; }
  match /users/{uid}/{nested=**} {
   allow read, write: if signed() && request.auth.uid == uid;
  }
  match /invites/{code} {
   allow get: if signed();
   allow list: if false;
   allow create: if signed() && request.resource.data.keys().hasOnly(['familyId','ownerId','expiresAt','active'])
    && request.resource.data.ownerId == request.auth.uid
    && request.resource.data.active == true
    && request.resource.data.expiresAt is int
    && request.resource.data.expiresAt > request.time.toMillis()
    && request.resource.data.expiresAt <= request.time.toMillis() + 86400000
    && owner(request.resource.data.familyId);
   allow update, delete: if false;
  }
  match /families/{fid} {
   allow get, list: if signed() && request.auth.uid in resource.data.memberIds;
   allow create: if signed()
    && request.resource.data.keys().hasOnly(['name','ownerId','memberIds','createdAt'])
    && request.resource.data.name is string && request.resource.data.name.size() <= 50
    && request.resource.data.ownerId == request.auth.uid
    && request.resource.data.memberIds == [request.auth.uid];
   allow update: if signed()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
    && !(request.auth.uid in resource.data.memberIds)
    && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
    && request.resource.data.memberIds.hasAll(resource.data.memberIds)
    && request.auth.uid in request.resource.data.memberIds
    && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid));
   allow delete: if false;
   match /members/{uid} {
    allow read: if member(fid);
    allow create: if signed() && uid == request.auth.uid
     && request.resource.data.keys().hasOnly(['name','joinedAt','inviteId'])
     && request.resource.data.name is string
     && request.resource.data.name.size() <= 100
     && (
       (owner(fid) && !('inviteId' in request.resource.data))
       || ('inviteId' in request.resource.data
         && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId))
         && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.familyId == fid
         && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.active == true
         && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.expiresAt > request.time.toMillis())
      );
    allow update, delete: if false;
   }
   match /expenses/{id} {
    allow read: if member(fid);
    allow create: if member(fid)
     && request.resource.data.keys().hasOnly(['amount','description','payerId','payerName','split','createdBy','date','createdAt'])
     && request.resource.data.amount is int && request.resource.data.amount > 0
     && request.resource.data.amount <= 99999999999
     && request.resource.data.description is string
     && request.resource.data.description.size() > 0
     && request.resource.data.description.size() <= 80
     && request.resource.data.createdBy == request.auth.uid
     && request.resource.data.payerId is string
     && (request.resource.data.payerId == 'shared' || request.resource.data.payerId in get(/databases/$(database)/documents/families/$(fid)).data.memberIds)
     && request.resource.data.split in ['equal','none'];
    allow update, delete: if false;
   }
  }
 }
}